# Dewey API key — get yours at https://meetdewey.com
# BYOK (bring-your-own-key) must be configured for both OpenAI and Anthropic
# in your Dewey project settings before running the benchmark.
DEWEY_API_KEY=dwy_live_...

# OpenAI API key — used only for the LLM judge in 03-score.ts (gpt-4o-mini)
# This is NOT used for the benchmark itself; generation goes through Dewey BYOK.
OPENAI_API_KEY=sk-...

# Optional: override the Dewey API base URL (default: https://api.meetdewey.com/v1)
# DEWEY_API_URL=http://localhost:3000/v1
